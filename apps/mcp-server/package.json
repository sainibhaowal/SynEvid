{
  "name": "@synevid/mcp",
  "version": "0.1.0",
  "description": "Zero-install Model Context Protocol (MCP) server for SynEvid (Code Autopsy)",
  "homepage": "https://github.com/sainibhaowal/SynEvid",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "@synevid/mcp": "./dist/index.js",
    "synevid-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.bundle.js --log-level=warning",
    "start": "node dist/index.js",
    "pretest": "npm run build && npm run build:bundle",
    "test": "node --test --test-concurrency=1 test/server.test.js test/e2e_agent_find_and_envelope.test.js test/e2e_agent_session.test.js test/bundle.test.js",
    "lint": "eslint src/ test/"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1"
  }
}
