{
  "name": "@code-autopsy/desktop",
  "version": "0.6.0",
  "desktopName": "SynEvid",
  "homepage": "https://github.com/sainibhaowal/SynEvid",
  "description": "SynEvid Native Desktop Application (Electron Shell)",
  "author": {
    "name": "SynEvid Team",
    "email": "rav.singh039@gmail.com"
  },
  "main": "src/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "start:electron": "node scripts/start.js",
    "test": "node --test test/*.test.js",
    "build:runtime": "node scripts/build-runtime.js",
    "forge": "electron-forge",
    "forge:package": "electron-forge package",
    "forge:make": "electron-forge make",
    "forge:publish": "electron-forge publish",
    "lint": "eslint src --ext .js,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "smoke:packaged": "node scripts/smoke-packaged.js",
    "smoke:installers": "node scripts/smoke-installers.js",
    "verify:artifacts": "node scripts/verify-artifacts.js"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@electron-forge/maker-appimage": "^7.0.0",
    "@electron-forge/maker-deb": "^7.0.0",
    "@electron-forge/maker-dmg": "^7.0.0",
    "@electron-forge/maker-squirrel": "^7.0.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.0.0",
    "@electron-forge/plugin-fuses": "^7.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-appimage": "^7.0.0",
    "@electron-forge/maker-deb": "^7.0.0",
    "@electron-forge/maker-dmg": "^7.0.0",
    "@electron-forge/maker-squirrel": "^7.0.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.0.0",
    "@electron-forge/plugin-fuses": "^7.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^8.50.0",
    "typescript": "^5.3.0"
  },
  "license": "Apache-2.0",
  "build": {
    "appId": "dev.synevid.desktop",
    "productName": "SynEvid",
    "icon": "../web/public/assets/logo_icon.png",
    "artifactName": "SynEvid-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "scripts/**",
      "package.json",
      "!src/.autopsy{,/**/*}"
    ],
    "win": {
      "target": ["nsis", "portable", "msi"]
    },
    "nsis": {
      "artifactName": "SynEvid-${version}-${os}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SynEvid"
    },
    "portable": {
      "artifactName": "SynEvid-${version}-${os}-${arch}-portable.${ext}"
    },
    "msi": {
      "artifactName": "SynEvid-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "Development",
      "executableName": "synevid",
      "syncDesktopName": true,
      "depends": [
        "libnotify4",
        "libsecret-1-0",
        "libnss3",
        "libatk1.0-0",
        "libatk-bridge2.0-0",
        "libcups2",
        "libdrm2",
        "libxkbcommon0",
        "libxcomposite1",
        "libxdamage1",
        "libxfixes3",
        "libxrandr2",
        "libgbm1",
        "libasound2"
      ],
      "maintainer": "SynEvid Team <rav.singh039@gmail.com>"
    },
    "extraResources": [
      {
        "from": "build/runtime/cockpit",
        "to": "cockpit"
      },
      {
        "from": "build/runtime/deps",
        "to": "deps"
      },
      {
        "from": "build/runtime/sidecars",
        "to": "sidecars"
      },
      {
        "from": "build/runtime/mcp-server",
        "to": "mcp-server"
      },
      {
        "from": "build/runtime/schemas",
        "to": "schemas"
      },
      {
        "from": "build/runtime/runtime-manifest.json",
        "to": "runtime-manifest.json"
      }
    ],
    "npmRebuild": false
  }
}