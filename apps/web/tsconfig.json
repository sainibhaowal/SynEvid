{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-browser-52639/types/**/*.ts",
    ".next-browser-52639/dev/types/**/*.ts",
    ".next-browser-60344/types/**/*.ts",
    ".next-browser-60344/dev/types/**/*.ts",
    ".next-browser-58232/types/**/*.ts",
    ".next-browser-58232/dev/types/**/*.ts",
    ".next-browser-65188/types/**/*.ts",
    ".next-browser-65188/dev/types/**/*.ts",
    ".next-browser-64876/types/**/*.ts",
    ".next-browser-64876/dev/types/**/*.ts",
    ".next-browser-53178/types/**/*.ts",
    ".next-browser-53178/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
