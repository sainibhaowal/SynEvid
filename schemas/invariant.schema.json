{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Autopsy Invariant",
  "type": "object",
  "required": [
    "id",
    "description",
    "kind",
    "severity"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]+$"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "scope": {
      "type": "object"
    },
    "rule": {
      "type": "object"
    }
  }
}